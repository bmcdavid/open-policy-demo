{
  "realm": "opa-demo",
  "enabled": true,
  "sslRequired": "none",
  "attributes": {
    "unmanagedAttributePolicy": "ENABLED"
  },
  "roles": {
    "realm": [
      {
        "name": "reader"
      },
      {
        "name": "editor"
      },
      {
        "name": "admin"
      },
      {
        "name": "platform-admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "demo-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String",
            "claim.name": "roles",
            "multivalued": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String",
            "claim.name": "tenant",
            "user.attribute": "tenant"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "reader-acme",
      "enabled": true,
      "emailVerified": true,
      "email": "reader-acme@example.test",
